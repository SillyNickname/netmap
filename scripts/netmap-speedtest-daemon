#!/usr/bin/env bash
# ==============================================================================
# NetMap - Standalone Speedtest Daemon Launcher
# Developed by: Antigravity (Google DeepMind)
# Requested and commissioned by: Andre Kajita <kajita@univap.br>
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Switch to virtual environment Python if available
PYTHON="python3"
if [ -x "$BASE_DIR/.venv/bin/python3" ]; then
    PYTHON="$BASE_DIR/.venv/bin/python3"
fi

export PYTHONPATH="$BASE_DIR:$PYTHONPATH"
exec "$PYTHON" -m netmap.speedtest_daemon "$@"
